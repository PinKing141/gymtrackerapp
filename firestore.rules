rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own document and everything
    // nested beneath it (e.g. basketballSessions/{id}/shots/{id}).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
